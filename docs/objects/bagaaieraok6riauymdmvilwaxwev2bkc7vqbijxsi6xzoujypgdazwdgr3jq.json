{
  "payload": {
    "type": "block",
    "kind": "article",
    "content": {
      "contentVersion": 1,
      "title": "Hello from Wirepost",
      "body": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "This post is a "
            },
            {
              "type": "strong",
              "children": [
                {
                  "type": "text",
                  "value": "signed, content-addressed object"
                }
              ]
            },
            {
              "type": "text",
              "value": ". So is every other post in this feed, and so is the record saying which posts exist."
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Nothing here needs a server. The whole publication is a folder of files:"
            }
          ]
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            {
              "type": "listItem",
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "value": "every post is addressed by the hash of its own contents"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "value": "the feed's identity is a hash, not a domain name"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "value": "moving hosts does not change what the feed "
                    },
                    {
                      "type": "emphasis",
                      "children": [
                        {
                          "type": "text",
                          "value": "is"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "quote",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "A verified badge means this came from this identity. It never means this is true."
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "You can follow this feed in a Wirepost reader, or subscribe with the Atom link below in any ordinary feed reader."
            }
          ]
        }
      ],
      "summary": "The first post on a feed that is nothing but static files.",
      "author": "With Lowe",
      "tags": [
        "wirepost",
        "static"
      ]
    },
